# Azeer Ticketing System - environment
# Copy to .env and fill in. Never commit the filled-in file.

# --- required ---------------------------------------------------------------

# Public URL employees will open. Must match the Zoho redirect URI exactly.
APP_BASE_URL=https://tickets.internal.azeer.com

# Random string, 32+ characters. Signs session cookies and encrypts the stored
# Zoho refresh tokens. Generate with:  openssl rand -base64 48
APP_SECRET=

# Zoho OAuth application (Server-based Application) from api-console.zoho.com.
# Authorised redirect URI must be exactly: <APP_BASE_URL>/api/auth/zoho/callback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Password that unlocks the admin panel. Separate from employee sign-in.
ADMIN_PASSWORD=

# --- strongly recommended ---------------------------------------------------

# Anthropic API key. Without it, descriptions pass through as the employee wrote
# them instead of being rewritten into professional English.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001

# Self Client refresh token. Used ONLY as a fallback for Zoho Desk when an
# employee has no Desk agent seat, and for the admin sync. It is never used to
# write CRM notes - those always use the employee's own token.
ZOHO_SERVICE_REFRESH_TOKEN=

# --- verified Zoho identifiers (change only if the portal changes) ----------

ZOHO_DC=com
ZOHO_DESK_ORG_ID=723454380
ZOHO_DESK_PORTAL_URL=https://help.azeer.com/support/twerlo
ZOHO_DESK_DEPARTMENT_ID=527933000044745084
ZOHO_DESK_LAYOUT_ID=527933000064576994
ZOHO_CRM_ORG_ID=717404780
ZOHO_CRM_AZEER_MODULE=Azeer

# --- optional ---------------------------------------------------------------

PORT=8080
NODE_ENV=production
DB_PATH=./data/azeer-tickets.db
SESSION_HOURS=12

# Copy platform login credentials from CRM into ticket bodies.
INCLUDE_CREDENTIALS=true
